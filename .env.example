# Generate real secrets with: python3 tools/setup_env.py
SECRET_KEY=
ADMIN_USERNAME=admin
# Bootstrap only. Ignored after the first database initialization.
ADMIN_PASSWORD=
# Bootstrap only: base32, 32+ characters. Enroll before first login.
# After onboarding, remove ADMIN_PASSWORD and ADMIN_TOTP_SECRET and recreate containers.
ADMIN_TOTP_SECRET=

SITE_NAME="The Members' Studio"
SITE_URL=http://localhost:8000
# Local HTTP only. MUST be true when deploying behind HTTPS.
COOKIE_SECURE=false
PORT=8000

# Register a v2 OAuth client: https://www.patreon.com/portal/registration/register-clients
# Redirect URI must exactly equal SITE_URL + /auth/patreon/callback
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CAMPAIGN_ID=
# Optional creator token with campaigns scope, used only by the admin tier sync.
PATREON_CREATOR_ACCESS_TOKEN=
